from app.assistant import get_summary_from_ai
from app.data import fetch_market_data
from app.indicators import add_indicators
from app.assistant import SimpleTradingAssistant


def run():
    print("=== AI Trading Assistant Simple ===")
    asset = input("Digite o ativo (ex.: AAPL, BTC): ").strip() or "AAPL"
    market = input("Digite o mercado (stock ou crypto): ").strip().lower() or "stock"

    if market not in {"stock", "crypto"}:
        raise ValueError("Mercado inválido. Use 'stock' ou 'crypto'.")

    raw_df = fetch_market_data(asset, market)
    df = add_indicators(raw_df)
    analysis = SimpleTradingAssistant(asset, market).get_summary()
    ai_summary = get_summary_from_ai(asset, market, analysis)

    print("\n=== RESUMO ===")
    print(ai_summary)
    print("\n=== DADOS RECENTES ===")
    print(df.tail(5).to_string(index=False))


if __name__ == "__main__":
    run()
